# 复制为 deploy/.env 后填入真实值，并执行 chmod 600 deploy/.env
# 严禁把真实值提交到版本库或写进镜像。

# ---- 数据库（chao_mysql 内网容器名 + 独立库 + 最小权限账号）----
# 密码中若含 @ : / ? # 等字符，必须做 URL 编码，否则 SQLAlchemy 解析会失败
DATABASE_URL=mysql+aiomysql://blog_app:CHANGE_ME@chao_mysql:3306/personal_blog?charset=utf8mb4

# ---- 会话签名密钥：openssl rand -hex 32 ----
JWT_SECRET=CHANGE_ME_32_BYTES_HEX

# ---- 首次启动写入的管理员初始密码（6~64 位）；登录后请在后台「站点设置」修改 ----
ADMIN_INIT_PASSWORD=CHANGE_ME

# ---- Cookie 安全位：未配置 HTTPS 时保持 false；接入 HTTPS 后改 true ----
COOKIE_SECURE=false

# ---- 会话有效期（小时）----
SESSION_TTL_HOURS=168

# ---- Uvicorn worker 数（3.6G 内存机器建议 2）----
UVICORN_WORKERS=2
