# 统一换行，避免 Windows 提交的 CRLF 破坏容器内的 shell 脚本
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile* text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.pem       binary
