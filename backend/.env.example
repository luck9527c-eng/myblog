# 本地开发环境变量模板：复制为 backend/.env 后填写真实值
#   Windows: copy backend\.env.example backend\.env
#   Linux:   cp backend/.env.example backend/.env
# 真实 .env 已被 .gitignore / .dockerignore 排除，绝不会进入版本库或镜像。

# ---------- 必填 ----------
# 必须 mysql+aiomysql:// 形式；密码含 @ : / ? # 等字符时要 URL 编码
DATABASE_URL=mysql+aiomysql://blog_app:CHANGE_ME@127.0.0.1:3306/personal_blog?charset=utf8mb4
# 会话签名密钥：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_HEX

# ---------- 首次启动必填 ----------
# 仅当 site_settings 表为空时用于初始化管理员密码（6~64 位）；之后可在后台修改
ADMIN_INIT_PASSWORD=CHANGE_ME

# ---------- 跑 pytest 时必填（独立库，测试会 DROP/重建表）----------
TEST_DATABASE_URL=mysql+aiomysql://blog_app:CHANGE_ME@127.0.0.1:3306/personal_blog_test?charset=utf8mb4

# ---------- 可选（括号内为默认值）----------
# COOKIE_SECURE=false                 # 上 HTTPS 后设 true
# SESSION_TTL_HOURS=168               # 会话有效期（小时）
# BCRYPT_ROUNDS=12                    # 测试环境可设 4 加速
# LOGIN_RATE_LIMIT_MAX=10             # 登录限流：窗口内最多失败次数
# LOGIN_RATE_LIMIT_WINDOW=60          # 登录限流窗口（秒）
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # 生产同源部署可留空
# UVICORN_WORKERS=2                   # 仅 entrypoint.sh 使用
# LOG_LEVEL=INFO
